NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/pennywise
# Replace with at least 32 random characters. Never commit a real secret.
JWT_SECRET=
CORS_ORIGINS=http://localhost:8081
# Optional: server-only credentials. Preset avatars work without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: Expo access token, only needed if enhanced push security is enabled for the project.
EXPO_ACCESS_TOKEN=
