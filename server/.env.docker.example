# Copy to .env.docker and generate your own random JWT secret.
# Backend container only; MongoDB remains on the host or in Atlas.
MONGODB_URI=mongodb://host.docker.internal:27017/pennywise
JWT_SECRET=
CORS_ORIGINS=http://localhost:8081
HOST_PORT=3000
# Optional: server-only credentials. Preset avatars work without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EXPO_ACCESS_TOKEN=
